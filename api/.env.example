# Copy to .env and fill in for local development.

NODE_ENV=development
PORT=3000

# Postgres — matches the docker-compose service at the repo root.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lead_tracker

# Origin allowed to call the API (the Angular dev server by default).
FRONTEND_URL=http://localhost:4200

# Valkey — matches the docker-compose service at the repo root. Backs
# both the session store and (later) rate limiting.
VALKEY_URL=redis://localhost:6379

# Sign/encrypt the session cookie. Any long random string in dev.
SESSION_SECRET=change-me-to-a-long-random-string

# Google Cloud OAuth 2.0 client — see README for how to create one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Shared secret the external source must send as X-Webhook-Secret.
WEBHOOK_SECRET=change-me-too
